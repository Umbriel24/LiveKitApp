@host = http://localhost:5250

### Crei un token con identity Alice
GET {{host}}/token?room=test&identity=alice
Accept: application/json

### Get di tutte le stanze
GET {{host}}/rooms
Accept: application/json

### Crea una lobby (come farebbe Unity)
POST {{host}}/rooms
Content-Type: application/json

{
  "userId": "unity-user-1",
  "displayName": "Mario"
}